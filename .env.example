# MS Entra ID / Azure AD Settings
AZURE_ENTRA_AD_CLIENT_ID=your-client-id-here
AZURE_ENTRA_TENANT_ID=your-tenant-id-here
AZURE_ENTRA_AD_CLIENT_SECRET=your-client-secret-here

# NextAuth Settings
NEXTAUTH_SECRET=generate-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:8081
NEXT_PUBLIC_API_URL=http://localhost:8081

# Admin Config
# List of Microsoft OIDs that should have Admin access
ADMIN_ENTRA_IDS=["oid-1", "oid-2"]

# Admin Login (Credentials-based fallback for testing/local)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your-admin-password-here

# Local Testing (Bypass SSO)
# Set this to a user UUID from seed_data.py to skip Entra ID validation locally
DEBUG_USER_ID=

# Database
# Local Docker (unified container + local postgres): postgresql+asyncpg://freshswipe:freshswipe@freshswipe-db:5432/freshswipe
# Production: set this to your Azure DB connection string
DATABASE_URL=
MSSQL_SA_PASSWORD=your-local-mssql-password-here

# Seed data
# Set to false to skip seeding on startup
SEED_ON_STARTUP=true
